# Copie para .env (nunca envie o .env para o git / Vercel; na Vercel defina as variáveis no painel do projecto)

# Neon > PostgreSQL > Connect > "External Database URL"
DATABASE_URL=postgresql://utilizador:senha@xxxx.frankfurt-postgres.neon.tech/mapa_lojas

# Alternativa SÓ para testar localmente sem Neon: base numa pasta (apague DATABASE_URL)
# PGLITE_DIR=dados_locais/pg

# 1 = validar também o certificado TLS do Neon (opcional)
# PGSSL_VERIFY=1
